{
  "name": "halowake-skills-registry",
  "version": "1.0.0",
  "description": "Centralized, verified, and automated Skills Registry pipeline for Halowake AI Coding Agent",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "registry:build": "tsx src/cli.ts build",
    "registry:validate": "tsx src/cli.ts validate",
    "registry:dry-run": "tsx src/cli.ts build --dry-run",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts"
  },
  "keywords": [
    "halowake",
    "agent-skills",
    "skills-registry",
    "ai-agent",
    "crawler",
    "sdlc"
