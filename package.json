  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhkai-ybwn/halowake-skills-registry.git"
  },
  "dependencies": {
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
